# ===========================================
# Tarife Attar Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# ---------------------------------------------
# Sanity CMS
# ---------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Read token (for fetching content)
SANITY_API_TOKEN=

# Write token (for mutations - admin only)
SANITY_API_WRITE_TOKEN=

# Webhook secret for cache revalidation (REQUIRED for security)
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------
# AI Services
# ---------------------------------------------
# OpenAI (for chat/curator features)
OPENAI_API_KEY=

# Anthropic Claude (for content generation)
ANTHROPIC_API_KEY=

# ---------------------------------------------
# Shopify
# ---------------------------------------------
# Admin API (server-side only)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# Storefront API (client-side safe)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Attribution and analytics (public/browser-safe)
NEXT_PUBLIC_SHOPIFY_CHECKOUT_DOMAIN=checkout.tarifeattar.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Email delivery (server-only; never expose with NEXT_PUBLIC_)
OMNISEND_API_KEY=

# ---------------------------------------------
# Etsy (Optional)
# ---------------------------------------------
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=

# ---------------------------------------------
# Admin Authentication
# ---------------------------------------------
# Secret token for admin panel access (REQUIRED for production)
# Generate with: openssl rand -base64 32
ADMIN_SECRET=

# ---------------------------------------------
# Security Notes
# ---------------------------------------------
# - Never commit .env.local to git
# - Rotate tokens regularly
# - Use different keys for dev/staging/production
# - SANITY_REVALIDATE_SECRET must be set in production
# - ADMIN_SECRET must be set in production

# ---------------------------------------------
# Showroom Booking — Google Calendar (Nida voice agent)
# ---------------------------------------------
# Run: node scripts/get-google-refresh-token.mjs to get the refresh token
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Generate: openssl rand -hex 32
SHOWROOM_WEBHOOK_SECRET=
# Preferred shared secret for all ElevenLabs/Nida webhook tools.
# Backward compatible fallback: SHOWROOM_WEBHOOK_SECRET.
VOICE_AGENT_WEBHOOK_SECRET=
# Optional — defaults to primary calendar and America/Los_Angeles
SHOWROOM_CALENDAR_ID=
SHOWROOM_TIMEZONE=

# ---------------------------------------------
# Voice Commerce Agent — Shopify Admin, SMS, Slack, Event Log
# ---------------------------------------------
SHOPIFY_ADMIN_API_VERSION=2026-01
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
SLACK_VOICE_ALERTS_WEBHOOK_URL=
SLACK_VOICE_SALES_WEBHOOK_URL=
SLACK_VOICE_SUMMARIES_WEBHOOK_URL=
SLACK_VIP_CUSTOMERS_WEBHOOK_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional browser voice widget. Requires a public ElevenLabs agent with auth
# disabled and tarifeattar.com allowlisted in ElevenLabs.
NEXT_PUBLIC_ENABLE_ELEVENLABS_WIDGET=false
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ---------------------------------------------
# Composio (AI tool integrations)
# ---------------------------------------------
# Get your key at: https://app.composio.dev/settings
COMPOSIO_API_KEY=
